{
 "texts": {
  "comp-lv9nslhl": "<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:70px;\"><span style=\"font-size:70px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Thrills and Tranquility</span></span></h1>",
  "comp-lv9nq9ed": "<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Embark on an unforgettable adventure at our homestay, where thrilling jeep safaris, scenic trekking trails, leisurely cycling routes, and captivating plantation walks await. Indulge in live barbeque evenings, adding a flavorful touch to your stay. Whether seeking adrenaline, our homestay offers diverse activities for every guest.</span></span></p>",
  "comp-lv9scxue": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:30px; line-height:normal;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Exciting Escapes &nbsp;</span></span></p>",
  "comp-lv70ebyc2": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Jeep Safari </span></span><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">(On Request)</span></span></p>",
  "comp-lv70ebyf": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Unleash Adventure, Discover Nature</span></h2>",
  "comp-lv70ebyg2": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Embark on a thrilling Jeep safari in Wagamon, starting at the stunning Wagamon View Point for panoramic hill and tea plantation views. Explore the intriguing Vellaramchitta Tunnel, enjoy scenic dam views, and experience an adrenaline-filled off-road ride through rugged terrain. It&#39;s an unforgettable adventure in Wagamon&#39;s natural beauty.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">* Extra Charges Apply</span></span></p>",
  "comp-lv9nwxfn": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; text-align:center; line-height:normal;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">01</span></span></span></span></span></p>",
  "comp-lv9nwxfn__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; text-align:center; line-height:normal;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">01</span></span></span></span></span></p>",
  "comp-lv9nzqc01": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">02</span></span></span></span></span></p>",
  "comp-lv9nzqc01__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">02</span></span></span></span></span></p>",
  "comp-lv70ebyi": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Paragliding </span></span><span style=\"font-size:40px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">(Seasonal)</span></span></p>",
  "comp-lv70ebyj": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Soar High with Wagamon Paragliding</span></h2>",
  "comp-lv70ebym": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Wagamon&#39;s paragliding experience is a breathtaking adventure that takes you soaring high above the lush landscapes of Kerala. Glide through the skies, feeling the rush of wind as you admire panoramic views of tea plantations, rolling hills, and serene lakes below. With experienced instructors and top-notch equipment, Wagamon offers a safe and exhilarating paragliding experience for thrill-seekers and nature lovers alike. It&#39;s a truly unforgettable way to experience the beauty of Wagamon from a whole new perspective.&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">*</span></span><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Extra Charges Apply</span></span></p>",
  "comp-lv70ebyn1": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Bicycling</span></span></p>",
  "comp-lv70ebyr": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Pedal Through Paradise</span></h2>",
  "comp-lv70ebyt": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Explore Wagamon&#39;s charm on two wheels, cycling through scenic villages and stunning landscapes. Discover the art of farming and spice cultivation, blending nature and culture into a captivating journey.</span></p>",
  "comp-lv9o1hej1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">03</span></span></span></span></span></p>",
  "comp-lv9o1hej1__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">03</span></span></span></span></span></p>",
  "comp-lv9o9g2s": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">04</span></span></span></span></span></p>",
  "comp-lv9o9g2s__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">04</span></span></span></span></span></p>",
  "comp-lv71msc0": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Hiking</span></span></p>",
  "comp-lv71msc9": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Vagamon&#39;s Windy Walk Trek</span></h2>",
  "comp-lv71msci": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Explore the scenic Vakavanam trail, known as Vagamon Windy Walk Trekking, through grasslands and shola forests. Enjoy stunning views of Idukki reservoir&#39;s catchment area and vast mountain ranges. Keep an eye out for wildlife like elephants. It&#39;s a serene and rewarding hike in Wagamon</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">*</span></span><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Extra Charges Apply</span></span><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">.</span></p>",
  "comp-lv96uuqp": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">BBQ &amp; Music</span></span></p>",
  "comp-lv96uuqw": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Sizzle, Strum, and Stars</span></h2>",
  "comp-lv96uur4": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">Indulge in an unforgettable evening of BBQ and music at our resort in Wagamon. Savour mouthwatering grilled delicacies under the starry sky, accompanied by live music that sets the perfect ambience. Whether you&#39;re gathering with friends, family, or loved ones, our BBQ and music night promises a delightful blend of flavours, melodies, and cherished moments in the heart of nature&#39;s tranquillity.</span></p>",
  "comp-lv9oh3a23": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">05</span></span></span></span></span></p>",
  "comp-lv9oh3a23__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">05</span></span></span></span></span></p>",
  "comp-lvcngs6z": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">06</span></span></span></span></span></p>",
  "comp-lvcngs6z__item1": "<p class=\"font_2 wixui-rich-text__text\" style=\"font-size:128px; line-height:normal; text-align:center;\"><span style=\"font-size:128px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:helvetica-w01-bold,helvetica-w02-bold,helvetica-lt-w10-bold,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0em;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">06</span></span></span></span></span></p>",
  "comp-lvcnh5as": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:80px;\"><span style=\"font-size:80px;\" class=\"wixui-rich-text__text\"><span class=\"color_18 wixui-rich-text__text\">Elephant Watch</span></span></p>",
  "comp-lvcnh5bj": "<h2 class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px; line-height:1.8em;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Witness Wild Elephants Grazing</span></h2>",
  "comp-lvcnh5c9": "<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:17px; line-height:1.8em;\"><span style=\"font-size:17px;\" class=\"wixui-rich-text__text\">At our homestay, guests can marvel at the sight of wild elephants peacefully grazing in the meadows, adding an unforgettable touch of natural beauty to their stay</span></p>"
 },
