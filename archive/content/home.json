{
 "texts": {
  "comp-lvtlw6dl": "<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:35px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-size:35px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.06em;\" class=\"wixui-rich-text__text\"><span style=\"font-family:brandon-grot-w01-light,brandon-grot-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">RUSTIC CHARM</span></span></span></span></span></p>\n\n<p class=\"font_0 wixui-rich-text__text\" style=\"font-size:35px; line-height:normal; text-align:center;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"font-size:35px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:0.06em;\" class=\"wixui-rich-text__text\"><span style=\"font-family:brandon-grot-w01-light,brandon-grot-w05-light,sans-serif;\" class=\"wixui-rich-text__text\">THATCHED ELEGANCE:<br class=\"wixui-rich-text__text\">\nUNWIND IN THE HEART OF NATURE</span></span></span></span></span></p>",
  "comp-iix9gelf": "<h1 class=\"font_5 wixui-rich-text__text\" style=\"line-height:normal; text-align:center; font-size:20px;\"><span style=\"letter-spacing:0.05em;\" class=\"wixui-rich-text__text\">Escape to The Mountain Table for an unforgettable getaway surrounded by misty hill views, cosy rooms, delectable local cuisine, and an infinity pool that beckons you to relax in style. Indulge in the serenity of nature&#39;s beauty and create lasting memories at our picturesque retreat.</span></h1>",
  "comp-iixajtum": "<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Nestled in the serene hills of Ulupuni, The Mountain Table offers a peaceful escape from the hustle and bustle of city life. Our homestay is a place where you can unwind, relax, and immerse yourself in the beauty of nature. Come and experience the tranquil charm of The Mountain Table.</span></p>",
  "comp-iixb5hdk": "<h2 class=\"font_4 wixui-rich-text__text\" style=\"line-height:normal; text-align:center; font-size:25px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">OUR ROOMS</span></h2>",
  "comp-iixb7ydi": "<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\">Indulge in the comfort of our well-appointed rooms, each offering breathtaking views of the mist-covered hills. The cozy ambiance and modern amenities ensure a delightful stay amidst the natural splendor.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\">Step into our&nbsp; three cozy rooms, where rustic charm meets modern comfort. Wake up to the sound of birds chirping and the gentle rustle of leaves outside your window, and feel the stresses of everyday life melt away in the embrace of nature.</p>",
  "comp-iizpxlxg": "<h2 class=\"font_4 wixui-rich-text__text\" style=\"text-align:center; font-size:25px;\">OUR SERVICES</h2>",
  "comp-iizq3pya": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Delight in a delectable spread of local cuisine with our complimentary breakfast offerings, our chef showcases the region&#39;s flavours.</span></p>",
  "comp-imq1cg362": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Stay connected with our complimentary Wi-Fi access and share your memorable moments with loved ones.</span></p>",
  "comp-iizqarz6": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Stroll through our lush garden and tea Plantation and revel in the tranquillity of the surroundings.</span></p>",
  "comp-imq1cg36": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Let us take care of the daily housekeeping, ensuring that your space remains pristine throughout your stay.</span></p>",
  "comp-iizqjzvp2": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Take a refreshing dip in our infinity pool while soaking in the panoramic vistas of the misty hills and meadows</span></p>",
  "comp-imq1cg35": "<p class=\"font_6 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Experience the epitome of leisure and entertainment with our resort&#39;s modern amenities</span></p>",
  "comp-ijcuq0hg": "<h2 class=\"font_4 wixui-rich-text__text\" style=\"line-height:normal; text-align:center; font-size:25px;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">DISCOVER</span></h2>",
  "comp-lv9nicew": "<h2 class=\"font_4 wixui-rich-text__text\" style=\"text-align:center; font-size:25px;\">GUEST REVIEW</h2>",
  "comp-imt1nrie": "<blockquote class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span class=\"color_36 wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">&ldquo;A tranquil haven amidst nature&#39;s embrace. The Mountain Table provided an enchanting retreat that exceeded all expectations.&rdquo;</span></span></blockquote>",
  "comp-ipwnvy85": "<blockquote class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span class=\"color_36 wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">Immerse yourself in the beauty of nature at The Mountain Table. An experience that lingers in the heart and beckons you to return.</span></span></blockquote>",
  "comp-ipwnw0m6": "<blockquote class=\"font_8 wixui-rich-text__text\" style=\"line-height:1.5em; text-align:center; font-size:18px;\"><span class=\"color_36 wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">The Mountain Table is a testament to serenity and hospitality. A destination that promises rejuvenation and lasting memories.</span></span></blockquote>"
 },
